COMPOSE_FILE=docker-compose.yml
# COMPOSE_PROFILES=certbot
DOMAIN=localhost
REAL_IP_PROVIDER=none

MONGODB_USER=libre-box
MONGODB_PASSWORD=REPLACE_WITH_MONGODB_PASSWORD

JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_JWT_REFRESH_SECRET

CREDS_KEY=REPLACE_WITH_CREDS_KEY
CREDS_IV=REPLACE_WITH_CREDS_IV

ADMIN_PANEL_SESSION_SECRET=REPLACE_WITH_ADMIN_PANEL_SESSION_SECRET

# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
# DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
# GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
# GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
# OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
# XAI_API_KEY=REPLACE_WITH_XAI_API_KEY

# SERPER_API_KEY=REPLACE_WITH_SERPER_API_KEY
# FIRECRAWL_API_KEY=REPLACE_WITH_FIRECRAWL_API_KEY
# JINA_API_KEY=REPLACE_WITH_JINA_API_KEY

# EGRESS_ALLOW_CIDRS=192.168.1.0/24
# EGRESS_BLOCK_CIDRS=203.0.113.10/32

SANDBOX_TARGET=standard
# SANDBOX_MEMORY_LIMIT=8G
# SANDBOX_CPU_LIMIT=4
# SANDBOX_PIDS_LIMIT=4096
# SANDBOX_SHM_SIZE=1gb

DEFAULT_COMMAND_TIMEOUT_SECONDS=600
OUTPUT_CHAR_LIMIT=100000

LOG_LEVEL=INFO
LOG_SERIALIZE=true