HOST=0.0.0.0
PORT=3080
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=768

APP_TITLE=LibreBox
HELP_AND_FAQ_URL=https://github.com/Kirill-Vaa/LibreBox/issues

ENDPOINTS=agents,anthropic,openAI,google,custom

ALLOW_SHARED_LINKS_PUBLIC=true
FILE_UPLOAD_SSE_ENABLED=true
SCHEDULES_SINGLE_PROCESS=true
ENABLE_INSIGHTS=true

DEPLOYMENT_PLUGINS_DIR=/app/plugins

FIRECRAWL_VERSION=v2

ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SESSION_EXPIRY=1000 * 60 * 60 * 8
REFRESH_TOKEN_EXPIRY=1000 * 60 * 60 * 24 * 90

FILE_UPLOAD_IP_MAX=999999
FILE_UPLOAD_IP_WINDOW=1
FILE_UPLOAD_USER_MAX=999999
FILE_UPLOAD_USER_WINDOW=1
FILE_USAGE_USER_MAX=999999
FILE_USAGE_USER_WINDOW=1

IMPORT_IP_MAX=999999
IMPORT_IP_WINDOW=1
IMPORT_USER_MAX=999999
IMPORT_USER_WINDOW=1

FORK_IP_MAX=999999
FORK_IP_WINDOW=1
FORK_USER_MAX=999999
FORK_USER_WINDOW=1

SHARE_IP_MAX=999999
SHARE_IP_WINDOW=1
SHARE_USER_MAX=999999
SHARE_USER_WINDOW=1

TTS_IP_MAX=999999
TTS_IP_WINDOW=1
TTS_USER_MAX=999999
TTS_USER_WINDOW=1

STT_IP_MAX=999999
STT_IP_WINDOW=1
STT_USER_MAX=999999
STT_USER_WINDOW=1

PROMPT_RESOLVE_USER_MAX=999999
PROMPT_RESOLVE_USER_WINDOW=1

AGENT_EVENT_USER_MAX=999999
AGENT_EVENT_USER_WINDOW=1